-// Codex refuses to spawn a non-OpenAI child while the parent is signed in with
-// a ChatGPT account, and says so in the parent's own message. That is a
-// property of the harness and the account, not of the route -- branding the
-// route "cannot run subagents" for it is the same wrong verdict as a 429.
+export function eventErrorCategory(events) {
+  const errors = (Array.isArray(events) ? events : [])
+    .filter((event) => event?.item?.type === "error")
+    .map((event) => JSON.stringify(event.item).toLowerCase())
+    .filter((error) => !/unrecognized configuration setting/.test(error))
+    .join("\n");
+  if (!errors) return undefined;
+  if (/encrypt|decrypt|cipher/.test(errors)) return "encrypted-message error";
+  if (/unknown agent|agent.*not found|invalid agent/.test(errors)) return "agent-resolution error";
+  if (/invalid.*argument|schema|tool.*argument/.test(errors)) return "tool-argument error";
+  if (/not supported.*chatgpt|current chatgpt account/.test(errors)) return "ChatGPT-account error";
+  if (/unauthor|forbidden|\b401\b|\b403\b/.test(errors)) return "authentication error";
+  if (/max.*thread|concurr|capacity|limit/.test(errors)) return "agent-capacity error";
+  if (/model|provider/.test(errors)) return "model-provider error";
+  return "unclassified Codex error";
+}
+
+// An account-policy response identifies the native Codex execution boundary,
+// not a routed child's inability to consume a delegated task. Keep it deferred
+// so the route is never rejected without reaching the collaboration path.
